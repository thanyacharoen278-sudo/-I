	local target =
		GetAimTarget()

	AimTarget =
		target

	if not target then
		return
	end

	local character =
		GetCharacter(target)

	local root =
		GetRoot(character)

	local camera =
		workspace.CurrentCamera

	if not root or not camera then
		return
	end

	pcall(function()

		camera.CFrame =
			CFrame.lookAt(
				camera.CFrame.Position,
				root.Position
			)

	end)
end)

