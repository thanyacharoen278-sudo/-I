--==================================================
-- CHARACTER FUNCTIONS
--==================================================

local function GetCharacter(player)

	if not player then
		return nil
	end

	return player.Character
end

local function GetRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(model)

	if not model then
		return nil
	end

	return model:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(model)

	local humanoid = GetHumanoid(model)

	return humanoid
		and humanoid.Health > 0
end

--==================================================
-- GET TARGETS
--==================================================

local function GetTargets()

	local character =
		GetCharacter(LocalPlayer)

	local root =
		GetRoot(character)

	if not root then
		return {}
	end

	local targets = {}

	for _, enemy in ipairs(Enemies:GetChildren()) do

		-- จำกัดจำนวนที่ตรวจ
		if #targets >= MAX_TARGETS then
			break
		end

		if enemy:IsA("Model")
			and enemy ~= character
			and enemy.Parent == Enemies then

			local humanoid =
				enemy:FindFirstChildOfClass("Humanoid")

			local enemyRoot =
				enemy:FindFirstChild("HumanoidRootPart")

			if humanoid
				and enemyRoot
				and humanoid.Health > 0 then

				local distance =
					(enemyRoot.Position - root.Position).Magnitude

				if distance <= RANGE then

					table.insert(
						targets,
						{
							Model = enemy,
							Distance = distance
						}
					)

				end
			end
		end
	end

	table.sort(targets, function(a, b)

		return a.Distance < b.Distance

	end)

	local result = {}

	for i = 1, math.min(#targets, MAX_TARGETS) do

		result[i] =
			targets[i].Model

	end

	return result
end

--==================================================
-- TARGET CACHE
--==================================================

local CachedTargets = {}
local LastTargetScan = 0

local function RefreshTargets()

	local now = os.clock()

	if now - LastTargetScan < TARGET_REFRESH then
		return CachedTargets
	end

	LastTargetScan = now

	local success, result =
		pcall(GetTargets)

	if success
		and type(result) == "table" then

		CachedTargets = result

	else

		CachedTargets = {}

	end

	return CachedTargets
end

--==================================================
-- GATHER
--==================================================

local LastGather = 0

local function GatherMonsters()

	local now = os.clock()

	if now - LastGather < GATHER_REFRESH then
		return
	end

	LastGather = now

	local character =
		GetCharacter(LocalPlayer)

	local root =
		GetRoot(character)

	if not root then
		return
	end

	local targets =
		RefreshTargets()

	local count =
		#targets

	if count == 0 then
		return
	end

	-- จำกัดจำนวน Gather ต่อรอบ
	local gatherCount =
		math.min(count, MAX_ATTACK_PER_CYCLE)

	for i = 1, gatherCount do

		local enemy =
			targets[i]

		if enemy
			and enemy.Parent == Enemies
			and IsAlive(enemy) then

			local angle =
				((i - 1) / math.max(gatherCount, 1))
				* math.pi * 2

			local offset =
				Vector3.new(
					math.cos(angle)
						* GATHER_DISTANCE,

					0,

					math.sin(angle)
						* GATHER_DISTANCE
				)

			local position =
				root.Position + offset

			pcall(function()

				enemy:PivotTo(
					CFrame.lookAt(
						position,
						root.Position
					)
				)

			end)
		end
	end
end

--==================================================
-- ATTACK
--==================================================

local function AttackTarget(enemy)

	if not enemy
		or enemy.Parent ~= Enemies then

		return false
	end

	local humanoid =
		GetHumanoid(enemy)

	local enemyRoot =
		GetRoot(enemy)

	if not humanoid
		or not enemyRoot
		or humanoid.Health <= 0 then

		return false
	end

	local character =
		GetCharacter(LocalPlayer)

	local root =
		GetRoot(character)

	if not root then
		return false
	end

	local distance =
		(enemyRoot.Position - root.Position).Magnitude

	if distance > RANGE then
		return false
	end

	-- หันตัวเข้าหามอน
	pcall(function()

		root.CFrame =
			CFrame.lookAt(
				root.Position,

				Vector3.new(
					enemyRoot.Position.X,
					root.Position.Y,
					enemyRoot.Position.Z
				)
			)

	end)

	-- Damage
	local success =
		pcall(function()

			if humanoid.Health > 0 then
				humanoid:TakeDamage(DAMAGE)
			end

		end)

	return success
end

--==================================================
-- PLAYER SEARCH
--==================================================

local function FindPlayerByName(name)

	if not name or name == "" then
		return nil
	end

	name =
		string.lower(
			string.gsub(name, "^%s*(.-)%s*$", "%1")
		)

	-- Exact username
	for _, player in ipairs(Players:GetPlayers()) do

		if string.lower(player.Name) == name then
			return player
		end

	end

	-- Exact display name
	for _, player in ipairs(Players:GetPlayers()) do

		if string.lower(player.DisplayName) == name then
			return player
		end

	end

	-- Partial username
	for _, player in ipairs(Players:GetPlayers()) do

		if string.find(
			string.lower(player.Name),
			name,
			1,
			true
		) then

			return player

		end
	end

	return nil
end

--==================================================
-- AIM LOCK
--==================================================

local AimTarget = nil

local function GetAimTarget()

	if not Settings.AimLock then
		return nil
	end

	local target =
		FindPlayerByName(
			Settings.AimPlayerName
		)

	if not target
		or target == LocalPlayer then

		return nil
	end

	local character =
		GetCharacter(target)

	local humanoid =
		GetHumanoid(character)

	local root =
		GetRoot(character)

	if not character
		or not humanoid
		or not root
		or humanoid.Health <= 0 then

		return nil
	end

	local myCharacter =
		GetCharacter(LocalPlayer)

	local myRoot =
		GetRoot(myCharacter)

	if not myRoot then
		return nil
	end

	local distance =
		(root.Position - myRoot.Position).Magnitude

	if distance > RANGE then
		return nil
	end

	return target
end

