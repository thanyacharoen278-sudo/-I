task.spawn(function()

	while Gui.Parent
		and Settings.Running do

		pcall(function()

			local targets =
				RefreshTargets()

			local target =
				targets[1]

			if target
				and target.Parent == Enemies
				and IsAlive(target) then

				local humanoid =
					GetHumanoid(target)

				if humanoid then

					TargetInfo.Text =
						"TARGET : "
						.. target.Name
						.. "\nHP : "
						.. math.floor(humanoid.Health)
						.. " / "
						.. math.floor(humanoid.MaxHealth)

				end

			else

				TargetInfo.Text =
					"TARGET : NONE\nHP : -"

			end

			if Settings.AimLock then

				local aimTarget =
					GetAimTarget()

				if aimTarget then

					AimInfo.Text =
						"AIM TARGET : "
						.. aimTarget.Name

				else

					AimInfo.Text =
						"AIM TARGET : NOT FOUND"

				end

			else

				AimInfo.Text =
					"AIM TARGET : NONE"

			end

		end)

		task.wait(0.15)

	end
end)

--==================================================
-- STABLE COMBAT LOOP
--==================================================

task.spawn(function()

	while Settings.Running do

		local success =
			pcall(function()

				-- Gather
				if Settings.Gather then
					GatherMonsters()
				end

				-- Auto Attack
				if not Settings.AutoAttack then

					task.wait(0.10)
					return

				end

				local targets =
					RefreshTargets()

				local attacked =
					0

				for _, enemy in ipairs(targets) do

					if not Settings.Running then
						break
					end

					if not Settings.AutoAttack then
						break
					end

					if attacked >=
						MAX_ATTACK_PER_CYCLE then

						break

					end

					if enemy
						and enemy.Parent == Enemies
						and IsAlive(enemy) then

						AttackTarget(enemy)

						attacked += 1

						if Settings.FastAttack then

							task.wait(
								FAST_DELAY
							)

						else

							task.wait(
								NORMAL_DELAY
							)

						end
					end
				end

				-- พักระหว่างรอบ
				task.wait(0.05)

			end)

		-- Error protection
		if not success then
			task.wait(0.25)
		end

	end
end)

