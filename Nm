-------------------------------------------------
task.spawn(function()
    while Settings.Running do
        pcall(function()
            if Settings.Gather then
                GatherMobs()
            end
            if Settings.AutoAttack then
                local targets = GetTargets()
                if #targets > 0 then
                    DoAttack(targets)
                end
            end
        end)

        if Settings.FastAttack then
            task.wait(FAST_DELAY)
        else
            task.wait(LOOP_DELAY)
        end
    end
end)

