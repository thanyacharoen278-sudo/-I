-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function Char(plr)
    plr = plr or LP
    return plr.Character
end

local function HRP(plr)
    local c = Char(plr)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Hum(model)
    return model and model:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(model)
    local h = Hum(model)
    return h and h.Health > 0
end

local function GetHitPart(model)
    return model:FindFirstChild("LeftLowerArm")
        or model:FindFirstChild("LeftUpperArm")
        or model:FindFirstChild("RightLowerArm")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
end

-------------------------------------------------
-- FIND PLAYER
-------------------------------------------------
local function FindPlayerByName(name)
    if not name or name == "" then return nil end
    name = string.lower(string.gsub(name, "^%s*(.-)%s*$", "%1"))

    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.DisplayName) == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), name, 1, true) then return p end
    end
    return nil
end

-------------------------------------------------
-- TARGETS
-------------------------------------------------
local function GetTargets()
    local h = HRP()
    if not h then return {} end
    local pos = h.Position
    local list = {}

    -- มอน
    local folder = workspace:FindFirstChild("Enemies")
    if folder then
        for _, mob in ipairs(folder:GetChildren()) do
            if #list >= MAX_TARGETS then break end
            if IsAlive(mob) then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local part = GetHitPart(mob)
                if root and part then
                    local d = (root.Position - pos).Magnitude
                    if d <= RANGE then
                        table.insert(list, { part = part, root = root, model = mob, dist = d, name = mob.Name })
                    end
                end
            end
        end
    end

    -- ผู้เล่น
    if Settings.AttackPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LP and #list < MAX_TARGETS then
                local c = Char(plr)
                if c and IsAlive(c) then
                    local root = HRP(plr)
                    local part = GetHitPart(c)
                    if root and part then
                        local d = (root.Position - pos).Magnitude
                        if d <= RANGE then
                            table.insert(list, { part = part, root = root, model = c, dist = d, name = plr.Name })
                        end
                    end
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-------------------------------------------------
-- ATTACK (ดรอปของได้)
-------------------------------------------------
local function DoAttack(targets)
    if #targets == 0 then return end
    if not RegisterAttack or not RegisterHit then return end

    pcall(function()
        RegisterAttack:FireServer(0.4, 1)
    end)

    for _, t in ipairs(targets) do
        if t.model and t.model.Parent and IsAlive(t.model) then
            pcall(function()
                local args = {
                    [1] = t.part,
                    [2] = {},
                    [4] = HIT_ID
                }
                RegisterHit:FireServer(unpack(args))
            end)
        end
    end
end

-------------------------------------------------
-- GATHER
-------------------------------------------------
local function GatherMobs()
    local h = HRP()
    if not h then return end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end

    local i = 0
    for _, mob in ipairs(folder:GetChildren()) do
        if IsAlive(mob) then
            local root = mob:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - h.Position).Magnitude <= GATHER_RANGE then
                i = i + 1
                local angle = (i / 14) * math.pi * 2
                local offset = Vector3.new(math.cos(angle) * GATHER_DIST, 0, math.sin(angle) * GATHER_DIST)
                pcall(function()
                    root.CFrame = CFrame.new(h.Position + offset)
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end
end

