local function PushController()
    pcall(function()
        if not AC then LoadCF() end
        local c = AC and AC.activeController
        if not c then return end
        c.timeToNextAttack = 0
        c.attacking = false
        c.blocking = false
        c.hitboxMagnitude = HITBOX
        if type(c.increment) == "number" then c.increment = 1 end
        if type(c.focusStart) == "number" then c.focusStart = 0 end
        if type(c.attack) == "function" then
            c:attack()
        end
    end)
end

local function Attack()
    NoShake()
    Equip()

    -- 1) CombatFramework
    PushController()

    -- 2) Tool Activate หลายครั้ง
    pcall(function()
        local tool = Char() and Char():FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
            task.wait(0.02)
            tool:Activate()
        end
    end)

    -- 3) executor mouse1 (ถ้ามี — ไม่โชว์เคอร์เซอร์แบบ VU)
    pcall(function()
        if type(mouse1click) == "function" then
            mouse1click()
        elseif type(mouse1press) == "function" then
            mouse1press()
            task.wait(0.02)
            if type(mouse1release) == "function" then mouse1release() end
        end
    end)
end

local function ClearBP()
    if bp then
        pcall(function() bp:Destroy() end)
        bp = nil
    end
end

local function EnsureBP(h)
    if bp and bp.Parent == h then return bp end
    ClearBP()
    local b = Instance.new("BodyPosition")
    b.Name = "DPVP_BP"
    b.MaxForce = Vector3.new(9e5, 9e5, 9e5)
    b.P = 80000
    b.D = 2000
    b.Parent = h
    bp = b
    return b
end

local function GoTo(goal)
    local h = HRP()
    if not h then return end
    local cur = h.Position
    local dist = (goal - cur).Magnitude

    -- บินเร็วขึ้น
    if dist > 200 then
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * math.min(dist, 400), goal)
    elseif dist > 1.5 then
        local step = math.min(dist, FLY_SPEED * 0.02)
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * step, goal)
    else
        h.CFrame = CFrame.new(goal)
    end

    pcall(function()
        local b = EnsureBP(h)
        b.Position = goal
    end)
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function Aim()
    local th = TargetRoot()
    local h = HRP()
    if not th or not h then return end
    local look = th.Position + Vector3.new(0, 1.5, 0)
    h.CFrame = CFrame.lookAt(h.Position, look)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, look) end
    end)
end

RunService.RenderStepped:Connect(function()
    if ON.Shake then NoShake() end
    local need = ON.Lock or ON.Fly or ON.Aim or ON.Attack
    if not need then
        ClearBP()
        return
    end
    local th = TargetRoot()
    if not th then return end
    if ON.Lock or ON.Fly then
        GoTo(th.Position + Vector3.new(0, LOCK_Y, 0))
    end
    if ON.Aim then Aim() end
    if ON.Attack then PushController() end
end)

