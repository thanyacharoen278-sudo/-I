local function Char()
    return LP.Character
end
local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function say(t)
    print("[D]", t)
    pcall(function()
        Notifier.new({ Title = "D", Content = t, Duration = 2, Icon = LOGO })
    end)
end

local function Nearest()
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, 1e9
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then
        else
            local ch = p.Character
            if ch then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local root = ch:FindFirstChild("HumanoidRootPart")
                if root and hum and hum.Health > 0 then
                    local d = (h.Position - root.Position).Magnitude
                    if d < bestD then
                        best = p
                        bestD = d
                    end
                end
            end
        end
    end
    return best
end

local function TargetRoot()
    local plr = nil
    if ON.Nearest or TargetName == "" then
        plr = Nearest()
        if plr then TargetName = plr.Name end
    else
        plr = Players:FindFirstChild(TargetName)
        if not plr then
            plr = Nearest()
            if plr then TargetName = plr.Name end
        end
    end
    if not plr or not plr.Character then return nil end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return plr.Character:FindFirstChild("HumanoidRootPart")
end

local function Equip()
    pcall(function()
        local c, hum = Char(), Hum()
        if not c or not hum then return end
        if c:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if not string.find(n, "fruit", 1, true) and not string.find(n, "gum", 1, true) then
                    hum:EquipTool(t)
                    return
                end
            end
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
    end)
end

local function LoadCF()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        local cf = ps and ps:FindFirstChild("CombatFramework")
        if cf then AC = require(cf) end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AC = v
                    break
                end
            end
        end
    end)
end
