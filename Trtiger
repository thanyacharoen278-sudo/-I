local function NoShake()
    if not ON.Shake then return end
    pcall(function()
        local u = RS:FindFirstChild("Util")
        local s = u and u:FindFirstChild("CameraShaker")
        if s then
            local m = require(s)
            if m and m.Stop then m:Stop() end
        end
    end)
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        local cf = ps and ps:FindFirstChild("CombatFramework")
        local cam = cf and cf:FindFirstChild("CameraShaker")
        if cam then
            local m = require(cam)
            if m and m.CameraShakeInstance then
                m.CameraShakeInstance.CameraShakeState = {
                    FadingIn = 3, FadingOut = 2, Sustained = 0, Inactive = 1
                }
            end
        end
    end)
end

